{
  "type": "object",
  "required": [
    "publisher",
    "name",
    "version",
    "contributes"
  ],
  "properties": {
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "contributes": {
      "type": "object",
      "properties": {
        "iconThemes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[a-zA-Z0-9_.-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "additionalProperties": true
          }
        },
        "productIconThemes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[a-zA-Z0-9_.-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "additionalProperties": true
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "iconThemes"
          ]
        },
        {
          "required": [
            "productIconThemes"
          ]
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxbit.dev/schemas/icon-manifest.v1.schema.json"
}
