{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/documents"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/host-browser"
    },
    {
      "path": "../../packages/host-runtime"
    }
  ]
}
