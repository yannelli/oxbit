{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*stash*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/hooks/run.mjs\" claude pre-shell",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(*pr merge*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/hooks/run.mjs\" claude pre-shell",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/hooks/run.mjs\" claude stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
