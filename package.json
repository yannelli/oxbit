{
  "name": "oxbit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "oxbit": "apps/runtime/dist/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/repair-pty.mjs",
    "repair:pty": "node scripts/repair-pty.mjs",
    "dev": "pnpm --filter @oxbit/runtime dev",
    "dev:web": "pnpm --filter @oxbit/web dev",
    "build": "tsc -b && pnpm --filter @oxbit/runtime build && pnpm build:example && pnpm --filter @oxbit/web build",
    "typecheck": "tsc -b",
    "lint": "eslint apps packages examples tests scripts --no-warn-ignored",
    "test": "vitest run",
    "test:browser": "playwright test",
    "start": "pnpm --filter @oxbit/runtime start",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "build:example": "pnpm build:sdk && pnpm --filter @oxbit/bundle-inspector exec vite build && node scripts/copy-example.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "install:global": "pnpm build && npm install -g .",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:runtime:test": "node scripts/desktop/smoke-runtime.mjs",
    "desktop:dev": "node scripts/desktop/run.mjs dev",
    "desktop:build": "node scripts/desktop/run.mjs build",
    "desktop:release": "node scripts/desktop/run.mjs build --release",
    "desktop:check": "node scripts/desktop/run.mjs check",
    "desktop:test:build": "node scripts/desktop/run.mjs native-build",
    "desktop:test:native": "wdio run tests/desktop/wdio.conf.mjs",
    "desktop:validate": "node scripts/desktop/validate.mjs",
    "desktop:test:installed": "node scripts/desktop/installed-smoke.mjs",
    "themes:generate": "node packages/themes/scripts/generate.mjs",
    "themes:validate": "tsx scripts/validate-theme-pack.ts",
    "themes:coverage": "node scripts/theme-coverage.mjs",
    "test:language:servers": "tsx scripts/language/smoke.ts",
    "icons:validate": "tsx scripts/validate-icon-pack.ts",
    "icons:schemas": "node scripts/generate-icon-schemas.mjs",
    "settings:schema": "tsx scripts/generate-settings-schema.ts",
    "settings:schema:check": "tsx scripts/generate-settings-schema.ts --check",
    "test:icons:browser": "playwright test --config tests/browser/icon-packs.config.ts",
    "test:themes:browser": "playwright test -c tests/browser/themes.config.ts",
    "test:icons:desktop": "node scripts/build-icon-native-tests.mjs && node scripts/run-icon-native-tests.mjs",
    "remote:prepare": "node scripts/desktop/prepare.mjs",
    "remote:test": "tsx scripts/remote/smoke.ts",
    "remote:test:native": "wdio run tests/desktop/remote.conf.mjs",
    "test:tasks": "vitest run apps/runtime/tests/task-config.test.ts apps/runtime/tests/task-runner.test.ts apps/runtime/tests/task-worktrees.test.ts packages/features/tasks/src/tasks.test.ts",
    "test:tasks:browser": "playwright test -c tests/browser/tasks.config.ts",
    "test:tasks:native": "wdio run tests/desktop/tasks.conf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "^10.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "@wdio/cli": "9.31.6",
    "@wdio/local-runner": "9.31.6",
    "@wdio/mocha-framework": "9.31.6",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "ajv": "^8.17.1",
    "eslint": "^9.35.0",
    "json-schema-to-typescript": "^15.0.4",
    "lightningcss": "1.30.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "@xterm/addon-ligatures": "0.11.0-beta.213"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Yannelli",
    "email": "ryanyannelli@gmail.com",
    "url": "https://github.com/yannelli"
  }
}
