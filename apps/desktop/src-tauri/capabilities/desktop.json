{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local Oxbit project windows. Native operations validate project ownership in Rust.",
  "windows": [
    "main",
    "project-*"
  ],
  "local": true,
  "permissions": [
    "core:event:default",
    "core:window:allow-is-focused",
    "core:window:allow-set-focus"
  ]
}
