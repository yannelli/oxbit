{
  "name": "oxbit-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HOSTS", "class_name": "RelayHost" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayHost"] }],
  "ratelimits": [
    { "name": "HOST_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
